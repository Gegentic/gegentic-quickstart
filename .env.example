# Copy to .env and fill in the values below. Defaults are wired up for
# docker-compose.yml -- don't change those unless you know what you're doing.

# ── Required: self-hosting license ──────────────────────────────────────────
# Register at https://gegentic.com to receive a license key.
LICENSE_KEY=

# ── Required: encryption keys for api ───────────────────────────────────────
# 64-character hex strings, generated with `openssl rand -hex 32`. Replace for
# anything beyond local experimentation.
ENCRYPT_KEY_FOR_API_KEY=56391a4be8dcc533d5af1b7720cd0775cfe5dcc774872462c567dc0682ada5f3
ENCRYPT_KEY_FOR_VIRTUAL_KEY=d3982444e1e1023e1cc97378a0fb28f3b04327e18e92daf6d7cc116ad907da71

# ── Required: at least one LLM credential for guardian's AI-based guardrails
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# ── Optional ─────────────────────────────────────────────────────────────────
# Internal auth shared between api and gateway. Must be a matching
# plaintext/hash pair (bcrypt), e.g.:
#   htpasswd -bnBC 10 "" yourpassword | tr -d ':\n'
LLM_GATEWAY_SERVICE_PASSWORD=local-dev-internal-secret
INTERNAL_AUTH_HASHED_PASSWORD=$$2y$$10$$x6LFi.viDSk6aWpzR3qfu.2tigtpm.T.XMhfIlB9dTM4YTfCKxnvW

# ── Optional: lock down the tracing service ─────────────────────────────────
# The tracing service (port 5001) is published on this machine and, by default, accepts trace
# uploads and trace reads from anything that can reach it. To restrict it to this stack's own
# services, set a shared secret and enforce it: the api, gateway and guardian send the secret and
# tracing refuses calls that lack it.
#   1. Generate a secret:  openssl rand -hex 32
#   2. Uncomment both lines below and put the secret in the first.
#   3. Pull the latest images first (docker compose pull). Images from before this feature don't send
#      the secret, so enforcing would block their trace uploads.
# Anything else that posts traces to port 5001 directly (for example a script using a trace SDK)
# must send them through the gateway's /api/trace with an access key instead.
# TRACING_AUTH_MODE=report logs calls that lack the secret but lets them through, to find any you missed.
# INTERNAL_SERVICE_SHARED_SECRET=
# TRACING_AUTH_MODE=enforce

# Comma-separated allowlist of emails permitted to sign up via email+password.
# Leave blank to allow anyone to sign up.
GEGENTIC_ALLOWED_SIGNUP_EMAILS=admin@example.com
